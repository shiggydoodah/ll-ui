{
  "name": "ll-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Louis Lombardi (https://github.com/shiggydoodah)",
  "repository": "github:shiggydoodah/ll-ui",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @ll-ui/lab dev",
    "kit:build": "pnpm --filter @ll-ui/react kit:build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm --filter @ll-ui/react verify && pnpm --filter @ll-ui/lab lint && pnpm --filter @ll-ui/lab typecheck && pnpm --filter @ll-ui/lab test && pnpm --filter @ll-ui/lab build",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml,html}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "description": "Personal React component library and design system: token-themed primitives, specimens, and a live playground."
}

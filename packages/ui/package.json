{
  "name": "@ll-ui/react",
  "version": "0.0.1",
  "private": true,
  "description": "Theme-agnostic React UI component library: primitives on a --ui-* CSS token contract, themed by small JSON configs compiled to CSS.",
  "license": "MIT",
  "author": "Louis Lombardi (https://github.com/shiggydoodah)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiggydoodah/ll-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/shiggydoodah/ll-ui#readme",
  "bugs": "https://github.com/shiggydoodah/ll-ui/issues",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "tailwindcss",
    "theming"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/ui/components/index.ts",
    "./hooks": "./src/ui/hooks/index.ts",
    "./icons": "./src/ui/icons/index.ts",
    "./integrations": "./src/ui/integrations/index.ts",
    "./primitives": "./src/ui/primitives/index.ts",
    "./providers": "./src/ui/providers/index.ts",
    "./types": "./src/types/index.ts",
    "./specimens": "./src/specimens/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme": "./src/theme/index.ts",
    "./themes/*": "./themes/*/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "themes:build": "tsx scripts/generate-themes.ts",
    "kit:build": "tsx scripts/export-design-kit.ts",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && tsx scripts/generate-themes.ts --check && node ./scripts/verify-css-exports.mjs && node ./scripts/verify-component-catalog.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "react-easy-crop": "^6.2.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
